# Copy this file to .env and fill in your own key to enable playlist
# import from a YouTube playlist URL on the host page. See README.md
# ("YouTube playlist import" under Windows always-on setup) for how to
# get a key. Everything else in the game works fine without this.
YOUTUBE_API_KEY=

# Optional: powers the "Auto-categories" game option (suggests a category
# per song from its artist's Spotify genre). See README.md ("Spotify
# auto-categories") for how to get these. Works fine with neither set.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: a shared PIN players/hosts must enter to join. Matters once the
# game is reachable from outside your own WiFi (e.g. via a Cloudflare
# Tunnel) — without it, anyone with the link could join or take over hosting.
# Leave blank and nothing changes: no PIN prompt appears anywhere. The TV
# screen never asks for it (it's a read-only kiosk display, not a control
# surface) — see README's "Playing from outside your WiFi" section.
JOIN_PIN=
